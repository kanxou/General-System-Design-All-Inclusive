      "boundElements": [],
      "updated": 1785649235213,
      "link": null,
      "locked": false,
      "text": "        Video Service\n        2. validateMetadata, videoLimit\n        3. generateVideoId(uuid, snowflake)\n        4. videoObjectKey generate\n        5. decideHowManyChunks(fileSize)\n        6. saveVideoMetadata(UPLOADING)\n        7. generatePresignedUrls - returns urls and uploadId (sessionId)\n        13. CompleteMultipartUpload(parts, uploadId) \n            - onSuccess change status to PROCESSING\n            If option A in step 12 then S3 drop event to Video SVC to update status\n        14. Drop Event to Kafka",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "d4LEJw6tMk-qdIh8PrdJa",
      "originalText": "        Video Service\n        2. validateMetadata, videoLimit\n        3. generateVideoId(uuid, snowflake)\n        4. videoObjectKey generate\n        5. decideHowManyChunks(fileSize)\n        6. saveVideoMetadata(UPLOADING)\n        7. generatePresignedUrls - returns urls and uploadId (sessionId)\n        13. CompleteMultipartUpload(parts, uploadId) \n            - onSuccess change status to PROCESSING\n            If option A in step 12 then S3 drop event to Video SVC to update status\n        14. Drop Event to Kafka",
      "autoResize": true,
      "lineHeight": 1.25
    },
