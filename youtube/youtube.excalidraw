    {
      "id": "bbKssabK6graMBY-15GCC",
      "type": "text",
      "x": -2849.2852549454615,
      "y": 424.7655075823358,
      "width": 850.5357055664062,
      "height": 540,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
