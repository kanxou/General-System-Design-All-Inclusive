      "versionNonce": 852027493,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785649140446,
      "link": null,
      "locked": false,
      "text": "        Non-FUNTIONAL REQUIREMENTS\n        -High Availability\n        -Low Startup Latency and Min Buffering\n        -Support very large video files.\n        -Global delivery.\n        -Durable storage.\n        -Eventual consistency is acceptable for:\n            -View counts\n            -Likes\n        -Strong Consistency for \n            -Privacy\n            -Video Deletion\n            -Access Control",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "7OvtkHH-DH_W379hxFugF",
      "originalText": "        Non-FUNTIONAL REQUIREMENTS\n        -High Availability\n        -Low Startup Latency and Min Buffering\n        -Support very large video files.\n        -Global delivery.\n        -Durable storage.\n        -Eventual consistency is acceptable for:\n            -View counts\n            -Likes\n        -Strong Consistency for \n            -Privacy\n            -Video Deletion\n            -Access Control",
      "autoResize": true,
      "lineHeight": 1.25
    },
