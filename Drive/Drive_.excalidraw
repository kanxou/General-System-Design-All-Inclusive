    {
      "id": "UCjgwlsN3H9YZ3ZpeBUt6",
      "type": "text",
      "x": 1258.2296737888353,
      "y": 622.6543849838647,
      "width": 668.8595581054688,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
